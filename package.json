{
  "name": "element-nice-ui",
  "version": "2.18.8",
  "description": "A Component Library for Vue.js.",
  "main": "lib/element-nice-ui.common.js",
  "files": [
    "lib",
    "src",
    "packages",
    "types",
    "vetur",
    "theme-chalk"
  ],
  "typings": "types/index.d.ts",
  "scripts": {
    "build:module": "node build/bin/build-module-declare.js",
    "build:file": "node build/bin/iconInit.js & node build/bin/build-entry.js",
    "build:theme": "node build/bin/gen-cssfile && gulp build --gulpfile theme-chalk/gulpfile.js && cp-cli theme-chalk/lib lib/theme-chalk",
    "build:utils": "cross-env BABEL_ENV=utils babel src --out-dir lib --ignore src/index.js",
    "build:umd": "node build/bin/build-locale.js",
    "clean": "rimraf lib && rimraf packages/*/lib && rimraf test/**/coverage",
    "dev:extension": "rimraf examples/extension/dist && cross-env NODE_ENV=development webpack --watch --config build/webpack.extension.js",
    "dev": "npm run bootstrap && npm run build:file && cross-env NODE_ENV=development webpack-dev-server --config build/webpack.demo.js & node build/bin/template.js",
    "play": "vite --config examples/vite.config.js",
    "dist": "npm run clean && npm run build:file && webpack --config build/webpack.conf.js && webpack --config build/webpack.common.js && webpack --config build/webpack.component.js && npm run build:utils && npm run build:umd && npm run build:theme",
    "release": "npm publish --registry=https://registry.npmjs.org",
    "pub": "pnpm dist && pnpm release"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:wenhongjie/element.git"
  },
  "homepage": "http://element.eleme.io",
  "keywords": [
    "eleme",
    "vue",
    "components"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ElemeFE/element/issues"
  },
  "unpkg": "lib/index.js",
  "style": "lib/theme-chalk/index.css",
  "dependencies": {
    "async-validator": "~1.8.1",
    "babel-helper-vue-jsx-merge-props": "^2.0.0",
    "bpmn-js": "^8.2.0",
    "deepmerge": "^1.2.0",
    "normalize-wheel": "^1.0.1",
    "resize-observer-polyfill": "^1.5.0",
    "sortablejs": "^1.13.0",
    "throttle-debounce": "^1.0.1",
    "ts-web-cache": "^1.0.9",
    "vuedraggable": "^2.24.3",
    "wangeditor": "^4.6.7"
  },
  "peerDependencies": {
    "vue": "^2.6.12"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.8",
    "@babel/core": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.2.1",
    "babel-plugin-transform-es2015-modules-umd": "6.24.1",
    "@vue/babel-preset-jsx": "^1.2.4",
    "@vue/component-compiler-utils": "^3.2.0",
    "algoliasearch": "^3.24.5",
    "babel-loader": "^8.2.2",
    "babel-plugin-module-resolver": "^4.1.0",
    "chokidar": "^3.4.3",
    "copy-webpack-plugin": "^5.0.0",
    "coveralls": "^3.0.3",
    "cp-cli": "^2.0.0",
    "cross-env": "^3.1.3",
    "css-loader": "^5.0.1",
    "es6-promise": "^4.0.5",
    "file-loader": "^1.1.11",
    "file-save": "^0.2.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-sass": "^6.0.1",
    "highlight.js": "^11.3.1",
    "html-webpack-plugin": "^3.2.0",
    "json-loader": "^0.5.7",
    "json-templater": "^1.0.4",
    "markdown-it": "^8.4.1",
    "markdown-it-anchor": "^5.0.2",
    "markdown-it-chain": "^1.3.0",
    "markdown-it-container": "^2.0.0",
    "mini-css-extract-plugin": "^1.3.3",
    "mocha": "^6.0.2",
    "optimize-css-assets-webpack-plugin": "^5.0.1",
    "postcss": "^8.2.1",
    "progress-bar-webpack-plugin": "^1.11.0",
    "rimraf": "^2.5.4",
    "sass-embedded": "^1.89.2",
    "sass-loader": "^16.0.5",
    "sass-migrator": "^1.5.2",
    "select-version-cli": "^0.0.2",
    "sinon": "^7.2.7",
    "babel-plugin-add-module-exports": "1.0.4",
    "sinon-chai": "^3.3.0",
    "style-loader": "^2.0.0",
    "transliteration": "^2.2.0",
    "typescript": "^4.1.3",
    "uglifyjs-webpack-plugin": "^2.1.1",
    "uppercamelcase": "^1.1.0",
    "url-loader": "^1.0.1",
    "vue": "^2.6.12",
    "vue-loader": "^15.9.6",
    "vue-router": "^3.0.1",
    "vue-template-compiler": "^2.6.12",
    "vue-template-es2015-compiler": "^1.6.0",
    "webpack": "^4.14.0",
    "webpack-cli": "^3.0.8",
    "webpack-dev-server": "^3.11.0",
    "webpack-node-externals": "^2.5.2",
    "cat-kit": "^3.7.13",
    "vite-plugin-vue2": "^1.9.3",
    "@vitejs/plugin-vue-jsx": "^1.3.10",
    "unplugin-vue-components": "^29.0.0",
    "vite": "npm:rolldown-vite@7.0.12"
  },
  "vetur": {
    "tags": "./vetur/tags.json",
    "attributes": "./vetur/attrs.json"
  }
}
